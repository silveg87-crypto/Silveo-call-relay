# Copy to your host's secret store. Never commit real values.

# --- ElevenLabs -------------------------------------------------------------
# Signing secret shown once when you create the workspace webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Agent ID of "Silveo personal Ai assistant". Events from any other agent
# (for example PlugSpeak agents) are ignored and never relayed.
ELEVENLABS_AGENT_ID=

# --- Twilio SMS ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
# Preferred: a Standard API key (revocable without touching the Auth Token).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alternative to the API key pair (leave empty if using the API key):
TWILIO_AUTH_TOKEN=
# Sender. Defaults to the imported assistant number if left empty.
TWILIO_FROM_NUMBER=+13502211417
# Silveo's personal phone in E.164 form (+1XXXXXXXXXX). Supplied by Silveo.
SILVEO_SMS_TO=

# --- Email (Resend) -----------------------------------------------------------
# Leave empty until Silveo approves the email sender; SMS still works and
# every summary marks email as pending.
RESEND_API_KEY=
# Example while no domain is verified: Silveo's AI assistant <onboarding@resend.dev>
EMAIL_FROM=

# --- Runtime ------------------------------------------------------------------
PORT=8080
# Must live on persistent storage so retries after a restart are de-duplicated.
STATE_FILE=./data/state.json
